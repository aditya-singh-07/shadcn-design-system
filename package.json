{
  "name": "design-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate:examples": "node scripts/generate-example-registry.mjs",
    "generate:ui": "node scripts/generate-ui-catalog.mjs",
    "generate": "npm run generate:ui && npm run generate:examples",
    "test:generator": "node scripts/verify-generator.mjs",
    "test:theme": "node scripts/verify-theme.mjs",
    "test:previews": "node scripts/verify-preview.mjs",
    "test:previews:render": "node scripts/verify-preview.mjs --render",
    "test:browser": "node scripts/browser-test-previews.mjs",
    "test:all": "npm run test:generator && npm run test:theme && npm run test:previews && npm run test:previews:render",
    "test:kit-examples": "node scripts/compare-kit-examples.mjs",
    "sync:kit-examples": "node scripts/compare-kit-examples.mjs 2>&1 | node scripts/sync-kit-examples.mjs --stdin || true",
    "resync:kit": "node scripts/resync-kit-from-registry.mjs",
    "patch:kit-base-ui": "node scripts/patch-kit-base-ui.mjs",
    "kit:match": "npm run resync:kit && npm run patch:kit-base-ui && npm run generate:examples && npm run test:kit-examples && npm run test:kit-compat",
    "test:kit-compat": "node scripts/verify-kit-ui-compat.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@remixicon/react": "^4.9.0",
    "@shadcn/react": "^0.3.1",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-payment-inputs": "^1.2.0",
    "react-phone-number-input": "^3.4.18",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^3.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "use-mask-input": "^3.14.4",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-payment-inputs": "^1.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
